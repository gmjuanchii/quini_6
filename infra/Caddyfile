# [003] R-20: enrutador de QUINI_6 (contracts/rutas.md § 3).
#
# Reglas, en este orden:
#   1.  /api/*, /static/*, /administracion/extracciones/*/csv/  → Django siempre
#   2.  /_next/*                                                → Next.js
#   3.  POST con ?_interfaz=django en QUINI6_RUTAS_NEXT          → Django (formularios de Django
#       abiertos antes de una conmutación o después de una reversa; los agrega {% accion_formulario %})
#   4.  QUINI6_RUTAS_NEXT (resto)                               → Next.js, con vuelta automática a
#       Django si Next.js no responde (FR-044, AC-14.6)
#   4b. QUINI6_RUTAS_NEXT_SIN_RESPALDO                          → Next.js sin respaldo (pantallas ya
#       retiradas de Django); si no responde, infra/no-disponible.html
#   5.  Todo lo demás                                           → Django
#
# QUINI6_RUTAS_NEXT y QUINI6_RUTAS_NEXT_SIN_RESPALDO: patrones separados por espacio
# (p. ej. "/administracion/extracciones/ /administracion/extracciones/*"). Vacías = ninguna ruta:
# compose.yaml pasa entonces un patrón que no coincide con nada (/_sin-rutas-next/).
#
# Reversa: quitar los patrones de la pantalla de QUINI6_RUTAS_NEXT y `caddy reload`.
#
# Vuelta automática (decisión de implementación de T153): comprobación de salud **pasiva** con
# reintento. Una comprobación activa necesitaría una ruta de Next.js que responda 2xx siempre, y el
# contrato no agrega rutas de salud (rutas.md § 4); "/" recién existe en Next.js con la pantalla 4.
# Si Next.js rechaza la conexión o responde 502/503/504, se lo marca no disponible por 10 s y el
# mismo pedido se reintenta con Django (lb_policy first + lb_try_duration).
{
	admin off
}

:8080 {
	encode zstd gzip

	# 1. Siempre Django.
	@django_siempre path /api/* /static/* /administracion/extracciones/*/csv/

	# 2. Recursos de Next.js.
	@next_assets path /_next/*

	# 3. POST de un formulario de Django en una ruta conmutada.
	@post_django {
		path {$QUINI6_RUTAS_NEXT:/_sin-rutas-next/}
		method POST
		query _interfaz=django
	}

	# 4. Rutas conmutadas a Next.js (con respaldo de Django).
	@next path {$QUINI6_RUTAS_NEXT:/_sin-rutas-next/}

	# 4b. Rutas de Next.js cuyas plantillas de Django ya se retiraron (sin respaldo).
	@next_sin_respaldo path {$QUINI6_RUTAS_NEXT_SIN_RESPALDO:/_sin-rutas-next/}

	handle @django_siempre {
		header X-Interfaz django
		reverse_proxy {$QUINI6_DJANGO_UPSTREAM:host.docker.internal:8000}
	}

	handle @next_assets {
		header X-Interfaz next
		reverse_proxy {$QUINI6_NEXT_UPSTREAM:host.docker.internal:3000}
	}

	handle @post_django {
		header X-Interfaz django
		reverse_proxy {$QUINI6_DJANGO_UPSTREAM:host.docker.internal:8000}
	}

	handle @next {
		# Quién respondió (diagnóstico; no contiene datos): Next.js envía su propia cabecera
		# X-Interfaz: next (frontend/next.config.ts); si atendió Django, queda "django".
		header ?X-Interfaz django
		# El primero disponible: Next.js; si no responde, Django (mismas direcciones, R-18).
		reverse_proxy {$QUINI6_NEXT_UPSTREAM:host.docker.internal:3000} {$QUINI6_DJANGO_UPSTREAM:host.docker.internal:8000} {
			lb_policy first
			lb_try_duration 3s
			lb_try_interval 250ms
			fail_duration 10s
			max_fails 1
			unhealthy_status 502 503 504
		}
	}

	handle @next_sin_respaldo {
		header X-Interfaz next
		reverse_proxy {$QUINI6_NEXT_UPSTREAM:host.docker.internal:3000}
	}

	# 5. Todo lo demás.
	handle {
		header X-Interfaz django
		reverse_proxy {$QUINI6_DJANGO_UPSTREAM:host.docker.internal:8000}
	}

	# AC-14.6: ningún destino respondió → página estática con el diseño y el pie legal.
	handle_errors 502 503 504 {
		header X-Interfaz ninguna
		root * /srv
		rewrite * /no-disponible.html
		file_server {
			status {err.status_code}
		}
	}
}
