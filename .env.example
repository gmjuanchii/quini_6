# Variables de entorno de QUINI_6. Copiar este archivo como .env y completar los valores.
# Nunca se suben valores reales al repositorio (R-15).

# Clave secreta de Django. Obligatoria cuando QUINI6_DEBUG=0.
QUINI6_SECRET_KEY=
# 1 = modo desarrollo; 0 = producción (activa cookies seguras, HTTPS y HSTS).
QUINI6_DEBUG=1
# Nombres de host permitidos, separados por coma.
QUINI6_ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos PostgreSQL. Si QUINI6_DB_NAME queda vacía se usa SQLite (db.sqlite3).
# [003] R-21: para trabajar con PostgreSQL 16 como en producción, completar QUINI6_DB_NAME=quini6
# y una contraseña, y levantar el contenedor con "docker compose up -d db". pytest usa la base que
# indique este archivo; vacía = SQLite (más rápido).
QUINI6_DB_NAME=
QUINI6_DB_USER=quini6
QUINI6_DB_PASSWORD=
QUINI6_DB_HOST=127.0.0.1
QUINI6_DB_PORT=5432

# Extracción histórica (spec 002): direcciones base de reemplazo de las fuentes F1, F2 y F3,
# solo para el servidor de fuentes de prueba (tests/fuentes_prueba). Vacías = sitios reales.
# QUINI6_FUENTE_F1_URL=
# QUINI6_FUENTE_F2_URL=
# QUINI6_FUENTE_F3_URL=

# [003] Convivencia de interfaces (Etapas 2 y 3) y enrutador Caddy (compose.yaml, infra/Caddyfile).
# Origen público del sitio: lo usa Django para CSRF_TRUSTED_ORIGINS y Next.js para las Server Actions.
QUINI6_ORIGEN_PUBLICO=http://localhost:8080
# Rutas servidas por Next.js, separadas por espacio (vacía en la Etapa 1). Ver contracts/rutas.md § 3.
QUINI6_RUTAS_NEXT=
# Rutas de pantallas cuyas plantillas de Django ya se retiraron (sin vuelta automática a Django).
QUINI6_RUTAS_NEXT_SIN_RESPALDO=
# Destinos del enrutador (desde el contenedor de Caddy hacia la máquina).
QUINI6_DJANGO_UPSTREAM=host.docker.internal:8000
QUINI6_NEXT_UPSTREAM=host.docker.internal:3000
# Dirección interna de Django que usa el servidor de Next.js para llamar a la API.
QUINI6_API_INTERNA=http://127.0.0.1:8000
# Monitoreo de errores (Etapa 3, P-01). Vacía = apagado (desarrollo y pruebas).
QUINI6_SENTRY_DSN=
# El mismo DSN para el navegador (Next.js lo incorpora al compilar). Vacía = apagado.
NEXT_PUBLIC_QUINI6_SENTRY_DSN=
# Nombre del entorno en Sentry (por omisión, "produccion").
QUINI6_SENTRY_ENTORNO=
# Archivo SQLite alternativo (por ejemplo, e2e.sqlite3 para los recorridos E2E). Vacía = db.sqlite3.
QUINI6_DB_SQLITE=
# 1 = habilita "manage.py preparar_e2e" (solo con QUINI6_DEBUG=1). Nunca en producción.
QUINI6_E2E=
