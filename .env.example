# Variables de entorno de QUINI_6. Copiar este archivo como .env y completar los valores.
# Nunca se suben valores reales al repositorio (R-15).

# Clave secreta de Django. Obligatoria cuando QUINI6_DEBUG=0.
QUINI6_SECRET_KEY=
# 1 = modo desarrollo; 0 = producción (activa cookies seguras, HTTPS y HSTS).
QUINI6_DEBUG=1
# Nombres de host permitidos, separados por coma.
QUINI6_ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos PostgreSQL. Si QUINI6_DB_NAME queda vacía se usa SQLite (db.sqlite3).
QUINI6_DB_NAME=
QUINI6_DB_USER=
QUINI6_DB_PASSWORD=
QUINI6_DB_HOST=
QUINI6_DB_PORT=5432
